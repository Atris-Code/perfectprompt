# ─────────────────────────────────────────────────────────────
# Nexo Sinérgico — Variables de entorno
# ─────────────────────────────────────────────────────────────
# IMPORTANTE: las claves de IA van SOLO en el backend (.env en la raíz
# del proyecto o variables de entorno del servidor). NUNCA en el frontend.
# El frontend ya no expone ninguna clave de API en el bundle.

# ── Backend (FastAPI) ──────────────────────────────────────
# URL de conexión a BD (SQLite local; Postgres en producción)
# DATABASE_URL=sqlite:///../nexo.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/nexo

# Clave JWT — usar un valor aleatorio largo en producción
SECRET_KEY=cambiar_por_una_clave_secreta_larga_y_aleatoria

# CORS: orígenes permitidos separados por coma (no usar "*" con credenciales)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://188.166.19.103

# Credenciales semilla (SOLO desarrollo — cambiar en producción)
DEMO_EMAIL=cientifico@nexo.com
DEMO_PASSWORD=ciencia123
ADMIN_EMAIL=admin@nexo.com
ADMIN_PASSWORD=admin123

# ── Proveedor de IA ────────────────────────────────────────
# OpenAI (primario): texto, JSON, visión, imagen, TTS
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o

# Anthropic Claude (fallback): texto, JSON, visión
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Frontend (Vite) ────────────────────────────────────────
# URL del backend para el navegador (proxy /api/ai, auth, etc.)
VITE_NEXO_BACKEND_URL=http://localhost:8000
